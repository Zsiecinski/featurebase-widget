{
  "name": "loop-app",
  "version": "1.0.0",
  "private": true,
  "description": "Loop — Intercom Canvas Kit app that surfaces a workspace's Featurebase changelog and roadmap inside the Messenger.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/db-migrate.mjs && node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/",
    "logos": "node scripts/generate-pngs.mjs",
    "db:migrate": "node scripts/db-migrate.mjs"
  },
  "dependencies": {
    "@sentry/node": "^10.55.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "sharp": "^0.33.5"
  }
}
