# Copy to .env and fill in. Never commit .env.
PORT=3000

# Featurebase REST API
# Get from Featurebase Dashboard -> Settings -> API
FEATUREBASE_API_KEY=
FEATUREBASE_BASE_URL=https://do.featurebase.app
FEATUREBASE_VERSION=2026-01-01.nova

# How long to wait on any single Featurebase request (ms).
FEATUREBASE_TIMEOUT_MS=5000

# How many times to retry the status-lookup call on failure.
FEATUREBASE_RETRIES=2

# When true, serves mocked data so you can develop without an API key.
# Auto-enabled whenever FEATUREBASE_API_KEY is empty.
FEATUREBASE_MOCK=false

# Optional. Restrict the changelog feed to one category by exact name, e.g.
# "Kiwi Size Chart & Recommender". Empty = every live changelog entry.
# The deprecated FEATUREBASE_BOARD name is still read as a fallback for
# already-deployed installs.
FEATUREBASE_CATEGORY=

# UI
ROADMAP_URL=https://staytuned.featurebase.app/roadmap/kiwi-sizing
MAX_ITEMS=8

# ═══════════════════════════════════════════════════════════════════════
# Multi-tenant / App Store mode (leave blank for single-tenant Staytuned)
# ═══════════════════════════════════════════════════════════════════════

# Postgres connection string. Railway: add the Postgres plugin and copy
# the DATABASE_URL from the variables tab.
DATABASE_URL=

# AES-256-GCM key for encrypting per-tenant Featurebase API keys at rest.
# Generate with: openssl rand -hex 32
FB_ENCRYPTION_KEY=

# Intercom OAuth credentials (Developer Hub → Authentication tab).
# Triggers multi-tenant mode when both are set.
INTERCOM_CLIENT_ID=
INTERCOM_CLIENT_SECRET=
INTERCOM_OAUTH_REDIRECT_URI=

# Sentry error reporting. When set, errors are sent to Sentry in addition to
# console logs. Requires @sentry/node to be installed as a runtime dep.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Admin token for /admin/* endpoints (support investigation, tenant lookup).
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Per-workspace rate limit (requests per minute). Default 120.
RATE_LIMIT_PER_MINUTE=120
