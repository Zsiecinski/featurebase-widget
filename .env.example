# Copy to .env and fill in. Never commit .env.
PORT=3000

# Featurebase REST API
# Get from Featurebase Dashboard -> Settings -> API
FEATUREBASE_API_KEY=
FEATUREBASE_BASE_URL=https://do.featurebase.app
FEATUREBASE_VERSION=2026-01-01.nova

# How long to wait on any single Featurebase request (ms).
FEATUREBASE_TIMEOUT_MS=5000

# How many times to retry the status-lookup call on failure.
FEATUREBASE_RETRIES=2

# When true, serves mocked data so you can develop without an API key.
# Auto-enabled whenever FEATUREBASE_API_KEY is empty.
FEATUREBASE_MOCK=false

# Optional. Restrict the Done list to a single Featurebase board.
# Accepts either:
#   - a board ID (24-char hex), or
#   - a board-name substring (case-insensitive), e.g. "Kiwi"
# Empty = show completed posts from every board in the org.
FEATUREBASE_BOARD=

# UI
ROADMAP_URL=https://staytuned.featurebase.app/roadmap/kiwi-sizing
MAX_ITEMS=8
